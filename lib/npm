init() { # {{{

	# load package manager agnostic functions
	mandatory_import "${myLIB}/agnostic"

	# conf
	NPM_PACKAGES="${HOME}/.local"
	NPM_LOCAL_CONF="${HOME}/.npmrc"
	NPM_BIN="${NPM_PACKAGES}/bin"
	NPM_MAN="${NPM_PACKAGES}/share/man"
	NPM_NODE="${NPM_PACKAGES}/lib/node_modules"

	# create local npm package installation directory
	create_dir_if_needed "${NPM_PACKAGES}"

	# npm global installs go to ~/.local
	# append_line_if_needed "prefix = ${NPM_PACKAGES}" "${NPM_LOCAL_CONF}"
	# as an alternative, if really needed
	# export NPM_CONFIG_PREFIX="${NPM_PACKAGES}"

	# add npm executables in PATH
	already_in_variable PATH "${NPM_BIN}" || {
		eval "$(generate_export_string PATH NPM_BIN)"
		append_line_if_needed "export PATH=${NPM_BIN}:\${PATH}" "${BASH_PATHS}"
	}

	# add npm man pages in MANPATH
	: ${MANPATH:=$(manpath)}
	already_in_variable MANPATH "${NPM_MAN}" || {
		eval "$(generate_export_string MANPATH NPM_MAN)"
		append_line_if_needed "$(generate_export_string MANPATH NPM_MAN)" "${BASH_PATHS}"
	}

	# add npm modules to NODE_PATH
	already_in_variable NODE_PATH "${NPM_NODE}" || {
		eval "$(generate_export_string NODE_PATH NPM_NODE)"
		append_line_if_needed "$(generate_export_string NODE_PATH NPM_NODE)" "${BASH_PATHS}"
	}

} # }}}

install() { # {{{
	local -a packages=(${@})
	for package in "${packages[@]}"; do
		npm_with_diagnostics install \
			--prefix "${NPM_PACKAGES}" \
			--global "${package}" || return $?
		log_package "${package}"
	done
} # }}}

uninstall() { # {{{
	local -a packages=(${@})
	for package in "${packages[@]}"; do
		npm uninstall \
			--prefix "${NPM_PACKAGES}" \
			--global "${package}"
		unlog_package "${package}"
	done
} # }}}

update() { # {{{
	local -a packages=() updates=()
	local package
	read_packages packages
	(( ${#packages[@]} )) || return 0
	for package in "${packages[@]}"; do
		if versioned_package "$package"; then
			slog "Skipping update of $package since it has a specific version"
		else
			updates+=("${package}")
		fi
	done
	(( ${#updates[@]} )) || return 0
	slog -h2 "${package_manager} update (${#updates[@]} packages)"
	npm_with_diagnostics update \
		--prefix "${NPM_PACKAGES}" \
		--global \
		--no-audit \
		"${updates[@]}"
} # }}}

npm_with_diagnostics() ( # {{{
	local output status=0 output_status=0
	output=$(mktemp) || return $?
	trap 'rm -f "$output"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	npm "$@" 2>&1 | tee "$output" || {
		status=${PIPESTATUS[0]} output_status=${PIPESTATUS[1]}
	}
	npm_warning_advice "$output" >&2
	(( status == 0 )) || return "$status"
	return "$output_status"
) # }}}

npm_warning_advice() { # {{{
	local output=$1 line spec package
	local blocked_package='^npm (warn|WARN) install-scripts[[:space:]]+((@[^/[:space:]]+/)?[^@[:space:]]+@[^[:space:]]+)[[:space:]]+\('
	if grep -Eq '^npm (warn|WARN) ERESOLVE overriding peer dependency' "$output"; then
		slog 'Peer dependency conflict: review the package chain above; update the affected parent package or report it to its maintainer.'
	fi
	if grep -Fq 'install scripts blocked because they are not covered by allowScripts' "$output"; then
		slog "npm blocked install scripts; affected tools may be incomplete. Pang installs into ${NPM_PACKAGES}."
		slog 'After reviewing and trusting each package, run the matching command to retry its scripts once:'
		while IFS= read -r line; do
			[[ $line =~ $blocked_package ]] || continue
			spec=${BASH_REMATCH[2]}
			package=${spec%@*}
			printf '  '
			printf '%q ' npm rebuild --prefix "$NPM_PACKAGES" --global --foreground-scripts "--allow-scripts=$package" "$spec"
			printf '\n'
		done < "$output"
		slog 'For future updates, add the approved package name to allow-scripts in ~/.npmrc, preserving existing entries.'
	fi
} # }}}

versioned_package() { # {{{
	local package="$1"
	[[ $package =~ ^@?[^@]+@[^@]+$ ]]
} # }}}

list() { # {{{
	while read -r package; do
		slog -h2 "${package_manager} view ${package}"
		npm view \
			--prefix "${NPM_PACKAGES}" \
			"${package}"
	done < "${log_file}"
} # }}}

init
