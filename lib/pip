init() { # {{{
	# load package manager agnostic functions
	mandatory_import "${myLIB}/agnostic"

	# add pip executables to PATH
	is_not_empty PY_USER_BIN || {
		declare -gx PY_USER_BIN="$(python -c 'import site; print(site.USER_BASE + "/bin")')"
		append_line_if_needed 'export PY_USER_BIN="$(python -c '"'"'import site; print(site.USER_BASE + "/bin")'"'"')"' "${BASH_PATHS}"
	}
	already_in_variable PATH "${PY_USER_BIN}" || {
		eval "$(generate_export_string PATH PY_USER_BIN)"
		append_line_if_needed '[ -x "$(command -v python)" ] && [ -x "$(command -v pip)" ] && export PATH="${PY_USER_BIN}:${PATH}"' "${BASH_PATHS}"
	}
} # }}}

install() { # {{{
	local -a packages=(${@})
	for package in "${packages[@]}"; do
		pip install --user --upgrade --break-system-packages "${package}"
		log_package "${package}"
	done
} # }}}

uninstall() { # {{{
	local -a packages=(${@})
	for package in "${packages[@]}"; do
		pip uninstall --break-system-packages "${package}" -y
		unlog_package "${package}"
	done
} # }}}

update() ( # {{{
	local -a packages=()
	local output package
	read_packages packages
	(( ${#packages[@]} )) || return 0

	# The subshell keeps cleanup traps local to this update.
	output=$(mktemp) || return $?
	trap 'rm -f "$output"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	slog -h2 "${package_manager} update (${#packages[@]} packages)"
	pip install --user --upgrade --break-system-packages "${packages[@]}" 2>&1 | tee "$output" || {
		local pip_status=${PIPESTATUS[0]} output_status=${PIPESTATUS[1]}
		(( output_status == 0 )) || return "$output_status"
		(( ${#packages[@]} > 1 )) && grep -q '^ERROR: ResolutionImpossible:' "$output" || return "$pip_status"
		slog "Dependency conflict; retrying packages individually"
		for package in "${packages[@]}"; do
			slog -h2 "${package_manager} update ${package}"
			pip install --user --upgrade --break-system-packages "${package}" || return $?
		done
	}
	pip check
) # }}}

list() { # {{{
	while read -r package; do
		slog -h2 "${package_manager} show ${package}"
		pip show "${package}"
	done < "${log_file}"
} # }}}

init
