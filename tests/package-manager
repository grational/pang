#!/usr/bin/env bash
set -eu

manager=${0##*/}
if [[ $manager == ruby ]]; then
	printf '%s/gems\n' "$HOME"
	exit 0
fi
if [[ $manager == tee ]]; then
	if [[ $PANG_TEST_MODE == output-failure ]]; then
		cat > /dev/null
		exit 31
	fi
	exec "$PANG_TEST_TEE" "$@"
fi

{
	printf '%q ' "$manager" "$@"
	printf '\n'
} >> "$PANG_TEST_CALLS"

[[ $manager != "${PANG_TEST_FAIL_MANAGER:-}" ]] || exit 23
if [[ $manager == npm ]]; then
	case "$PANG_TEST_MODE" in
		npm-peer|npm-warnings|npm-warning-failure)
			echo 'npm warn ERESOLVE overriding peer dependency' >&2
			;;
	esac
	case "$PANG_TEST_MODE" in
		npm-blocked|npm-warnings|npm-warning-failure)
			cat >&2 <<-'WARNINGS'
			npm warn install-scripts 2 packages had install scripts blocked because they are not covered by allowScripts:
			npm warn install-scripts   @opencode/cli@2.2.6 (postinstall: node ./postinstall.mjs)
			npm warn install-scripts   native-tool@1.0.0-beta.2 (install: node ./install.js)
			WARNINGS
			;;
		npm-unknown-warning)
			echo 'npm warn deprecated some-package@1.0.0: no longer supported' >&2
			;;
		npm-interrupted)
			kill -TERM "$PPID"
			exit 143
			;;
	esac
	[[ $PANG_TEST_MODE != npm-warning-failure ]] || exit 29
	exit 0
fi
[[ $manager == pip ]] || exit 0

if [[ $1 == check ]]; then
	[[ $PANG_TEST_MODE != *broken* ]] || exit 19
	exit 0
fi

shift 4 # install --user --upgrade --break-system-packages
case "$PANG_TEST_MODE" in
	conflict*|single-conflict)
		if (( $# > 1 )) || [[ $PANG_TEST_MODE == single-conflict ]]; then
			echo 'ERROR: ResolutionImpossible: conflicting dependencies' >&2
			exit 1
		fi
		if [[ $PANG_TEST_MODE == conflict-retry-failure && $1 == beta ]]; then
			exit 29
		fi
		;;
	network)
		echo 'ERROR: Connection timed out' >&2
		exit 7
		;;
	permission)
		echo 'ERROR: Permission denied' >&2
		exit 13
		;;
	unknown)
		echo 'ERROR: Unknown failure' >&2
		exit 17
		;;
	interrupted)
		kill -TERM "$PPID"
		exit 143
		;;
esac
